{
  "name": "campus",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "众校通智慧校园 Vue 3 前端框架 Monorepo",
  "type": "module",
  "license": "MIT",
  "author": "UnionSchool",
  "homepage": "https://campus.zhongxiaotong.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnionSchool/campus.git"
  },
  "bugs": {
    "url": "https://github.com/UnionSchool/campus/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:locale": "node scripts/check-locale.mjs",
    "typecheck": "pnpm --filter @unionschool/campus-core typecheck && pnpm --filter @unionschool/campus-framework typecheck && pnpm --filter @unionschool/campus-ui typecheck && pnpm --filter @unionschool/campus-admin typecheck && pnpm --filter @unionschool/example-* typecheck",
    "build:core": "pnpm --filter @unionschool/campus-core build",
    "build:framework": "pnpm --filter @unionschool/campus-framework build",
    "build:ui": "pnpm --filter @unionschool/campus-ui build",
    "build:admin": "pnpm --filter @unionschool/campus-admin build",
    "build:packages": "npm run build:core && npm run build:framework && npm run build:ui && npm run build:admin",
    "build:example": "pnpm --filter @unionschool/example-* build",
    "build:example:admin": "pnpm --filter @unionschool/example-admin build",
    "build:demo": "npm run build:example",
    "build": "npm run build:packages",
    "dev": "pnpm --filter @unionschool/example-admin dev",
    "dev:admin": "pnpm --filter @unionschool/example-admin dev",
    "preview": "pnpm --filter @unionschool/example-admin preview",
    "preview:admin": "pnpm --filter @unionschool/example-admin preview",
    "preview:example": "pnpm --filter @unionschool/example-admin preview",
    "up": "bash ./up",
    "deploy": "node scripts/deploy.mjs",
    "clean": "node scripts/clean.mjs all",
    "check": "npm run check:boundaries && npm run check:locale && npm run build:packages && npm run typecheck && npm run build:example && npm run pack:dry",
    "pack:dry": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
