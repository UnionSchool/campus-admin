{
  "name": "@unionschool/campus-admin",
  "version": "0.1.0-alpha.1",
  "description": "面向智慧校园后台管理场景的完整 Vue 3 框架入口",
  "type": "module",
  "license": "MIT",
  "author": "UnionSchool",
  "homepage": "https://campus.zhongxiaotong.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnionSchool/campus.git",
    "directory": "packages/campus-admin"
  },
  "keywords": [
    "vue",
    "vue3",
    "campus",
    "school",
    "admin",
    "dashboard"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "types"
  ],
  "main": "./dist/campus-admin.umd.cjs",
  "module": "./dist/campus-admin.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ca": [
        "./types/ca.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/campus-admin.js",
      "require": "./dist/campus-admin.umd.cjs",
      "source": "./src/index.ts"
    },
    "./style.css": {
      "import": "./dist/campus-admin.css",
      "default": "./dist/campus-admin.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/clean.mjs dist:packages/campus-admin && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json && vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.44.0",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@unionschool/campus-core": "workspace:^",
    "@unionschool/campus-framework": "workspace:^",
    "@unionschool/campus-ui": "workspace:^"
  },
  "devDependencies": {
    "@lucide/vue": "^1.44.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
