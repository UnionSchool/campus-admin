{
  "name": "@unionschool/campus-ui",
  "version": "0.1.0-alpha.1",
  "description": "面向智慧校园后台场景的 Vue 3 组件库",
  "type": "module",
  "license": "MIT",
  "author": "UnionSchool",
  "homepage": "https://campus.zhongxiaotong.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnionSchool/campus.git",
    "directory": "packages/campus-ui"
  },
  "keywords": [
    "vue",
    "vue3",
    "campus",
    "school",
    "admin",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/campus-ui.umd.cjs",
  "module": "./dist/campus-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/campus-ui.js",
      "require": "./dist/campus-ui.umd.cjs",
      "source": "./src/index.ts"
    },
    "./style.css": {
      "import": "./dist/campus-ui.css",
      "default": "./dist/campus-ui.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/clean.mjs dist:packages/campus-ui && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json && vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.44.0",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@unionschool/campus-framework": "workspace:^"
  },
  "devDependencies": {
    "@lucide/vue": "^1.44.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
